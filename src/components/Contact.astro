---
const mapSrc = 'https://maps.google.com/maps?q=' +
  encodeURIComponent('Lubo Taller, Calle del Capitán Francisco Sánchez 34, 28100 Alcobendas, Madrid') +
  '&z=16&output=embed';
---

<section id="contacto" class="section contact">
  <div class="container">
    <h2 class="t-h2">Ven a vernos</h2>

    <div class="grid">
      <div class="info">
        <a href="tel:+34654463966" class="t-phone phone">654 463 966</a>
        <a href="https://wa.me/34654463966" target="_blank" rel="noopener noreferrer" class="btn btn-primary wa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Escríbenos por WhatsApp
        </a>

        <dl class="details">
          <div>
            <dt class="t-h3">Horario</dt>
            <dd>
              <table class="hours">
                <tbody>
                  <tr><th scope="row">Lunes a viernes</th><td>9:00–14:00<br />15:30–19:00</td></tr>
                  <tr><th scope="row">Sábado y domingo</th><td>Cerrado</td></tr>
                </tbody>
              </table>
            </dd>
          </div>
          <div>
            <dt class="t-h3">Dirección</dt>
            <dd>
              <address>C/ Capitán Francisco Sánchez 34<br />28100 Alcobendas, Madrid</address>
              <a class="link" href="https://www.google.com/maps/dir/?api=1&destination=Lubo+Taller+Alcobendas" target="_blank" rel="noopener noreferrer">Cómo llegar</a>
            </dd>
          </div>
          <div>
            <dt class="t-h3">Correo</dt>
            <dd><a class="link" href="mailto:lubogaragesl@gmail.com">lubogaragesl@gmail.com</a></dd>
          </div>
        </dl>
      </div>

      <div class="map">
        <iframe
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa: Lubo Taller en C/ Capitán Francisco Sánchez 34, Alcobendas"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { background: var(--color-surface); }
  h2 { margin: 0 0 var(--s6); }
  .grid { display: grid; gap: var(--s6); }
  .phone { display: inline-block; text-decoration: none; }
  .phone:hover { color: var(--color-rust-dark); }
  .wa { margin-top: var(--s4); }
  .details { margin: var(--s6) 0 0; display: grid; gap: var(--s5); }
  .details dt { margin-bottom: var(--s2); }
  .details dd { margin: 0; }
  address { font-style: normal; }
  .hours { border-collapse: collapse; }
  .hours th { text-align: left; font-weight: 500; padding: 0 var(--s4) var(--s2) 0; vertical-align: top; color: var(--color-ink); }
  .hours td { padding: 0 0 var(--s2); font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.25; color: var(--color-navy); }
  .link { color: var(--color-navy); text-underline-offset: 3px; display: inline-block; margin-top: var(--s1); min-height: 24px; }
  .link:hover { text-decoration-thickness: 2px; }
  .map { border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden; min-height: 380px; background: var(--color-concrete); }
  .map iframe { display: block; width: 100%; height: 100%; min-height: 380px; border: 0; }

  @media (min-width: 900px) {
    .grid { grid-template-columns: 5fr 7fr; column-gap: var(--s7); }
  }
</style>
