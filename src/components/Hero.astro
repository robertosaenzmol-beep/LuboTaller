---
import { Image } from 'astro:assets';
import heroWorkshop from '../assets/photos/hero-workshop.jpg';
import HexPattern from './graphics/HexPattern.astro';
---

<section
  class="sc-hero relative flex min-h-screen items-center overflow-hidden pt-[72px]"
  aria-label="Presentacion de Lubo Taller"
>
  <!-- Background plane (parallax layer 0) -->
  <div class="sc-hero__bg absolute inset-0" aria-hidden="true">
    <Image
      data-hero-bg
      src={heroWorkshop}
      alt=""
      class="absolute inset-0 h-full w-full object-cover will-change-transform"
      style="transform: scale(1.06);"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Hex pattern echoing the real LED ceiling -->
  <div class="absolute inset-0" aria-hidden="true">
    <HexPattern id="hero-hex" opacity={0.25} scale={1.2} />
  </div>

  <!-- Corner scrim (lead pattern: heavy bottom-left, transparent top-right) -->
  <div class="sc-scrim--lead absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Content plane (parallax layer 1) -->
  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6 md:px-8 lg:px-12">
    <div class="flex items-center justify-between gap-12">
      <!-- Left: text stack (max 4 elements) -->
      <div class="flex-1">
        <!-- 1. Eyebrow -->
        <p
          data-hero-eyebrow
          class="text-[10px] font-semibold uppercase tracking-[0.25em] opacity-0"
          style="font-family: var(--font-body); color: var(--color-accent);"
        >
          Taller mec&aacute;nico en Alcobendas. Desde 1984
        </p>

        <!-- 2. Headline (2 lines, kinetic entrance per line) -->
        <h1
          data-hero-h1
          class="mt-6 max-w-[900px] font-bold italic leading-[0.92] tracking-[-0.03em]"
          style="font-family: var(--font-display); font-size: clamp(3rem, 9vw, 7.5rem); color: var(--color-ink);"
        >
          <span class="sc-hero__line block overflow-hidden">
            <span class="sc-hero__line-inner block" style="transform: translateY(100%);">Tu taller de</span>
          </span>
          <span class="sc-hero__line block overflow-hidden">
            <span class="sc-hero__line-inner block" style="transform: translateY(100%);">confianza</span>
          </span>
        </h1>

        <!-- 3. Subtitle (under 20 words) -->
        <p
          data-hero-subtitle
          class="mt-8 max-w-[540px] font-light leading-[1.7] tracking-[0.01em] opacity-0"
          style="font-family: var(--font-body); font-size: clamp(0.875rem, 1.5vw, 1.1rem); color: var(--color-ink-soft);"
        >
          Reparaci&oacute;n, mantenimiento y diagnosis con m&aacute;s de 40 a&ntilde;os de experiencia. Presupuesto sin compromiso.
        </p>

        <!-- 4. CTAs -->
        <div data-hero-cta class="mt-12 flex flex-wrap items-center gap-4 opacity-0">
          <a
            href="https://wa.me/34654463966"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-shimmer inline-block px-10 py-4 text-[11px] font-semibold uppercase tracking-[0.15em] transition-colors duration-500 hover:bg-[var(--color-accent-light)] active:scale-[0.98]"
            style="font-family: var(--font-body); background: var(--color-accent); color: var(--color-ink);"
          >
            Pide cita
          </a>
          <a
            href="tel:+34654463966"
            class="inline-block border px-10 py-4 text-[11px] font-semibold uppercase tracking-[0.15em] transition-all duration-500"
            style="font-family: var(--font-body); border-color: rgba(245,235,221,0.15); color: rgba(245,235,221,0.7);"
            onmouseenter="this.style.borderColor='rgba(200,169,110,0.4)';this.style.color='var(--color-accent-light)'"
            onmouseleave="this.style.borderColor='rgba(245,235,221,0.15)';this.style.color='rgba(245,235,221,0.7)'"
          >
            654 463 966
          </a>
        </div>
      </div>

      <!-- Right: Logo badge (lg+ only, separate parallax rate) -->
      <div
        data-hero-logo
        class="hidden shrink-0 opacity-0 lg:flex lg:items-center lg:justify-center"
      >
        <img
          src="/logo-lubo.png"
          alt=""
          class="h-auto w-[220px] drop-shadow-[0_0_40px_rgba(161,98,7,0.25)]"
          style="transform: scale(0.95);"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Corner scrim: radial gradient anchored bottom-left, fading to transparent top-right */
  .sc-scrim--lead {
    background:
      radial-gradient(ellipse at 0% 100%, var(--color-canvas) 0%, transparent 70%),
      linear-gradient(to top, var(--color-canvas) 0%, rgba(10,8,6,0.8) 30%, transparent 58%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const heroSection = document.querySelector(".sc-hero") as HTMLElement | null;
  const heroBg = document.querySelector("[data-hero-bg]") as HTMLElement | null;
  const eyebrow = document.querySelector("[data-hero-eyebrow]") as HTMLElement | null;
  const lineInners = document.querySelectorAll(".sc-hero__line-inner");
  const subtitle = document.querySelector("[data-hero-subtitle]") as HTMLElement | null;
  const cta = document.querySelector("[data-hero-cta]") as HTMLElement | null;
  const heroLogo = document.querySelector("[data-hero-logo]") as HTMLElement | null;
  const logoImg = heroLogo?.querySelector("img") as HTMLElement | null;

  // Collect all elements that need to be visible
  const allEls = [eyebrow, subtitle, cta, heroLogo, ...Array.from(lineInners)].filter(Boolean);

  if (prefersReducedMotion) {
    // Immediately show everything, no animation
    if (heroBg) heroBg.style.transform = "scale(1)";
    allEls.forEach((el) => {
      (el as HTMLElement).style.opacity = "1";
      (el as HTMLElement).style.transform = "none";
    });
    if (logoImg) {
      logoImg.style.transform = "scale(1)";
    }
  } else {
    // ── Background: scale 1.06 → 1 over 4s ──
    if (heroBg) {
      gsap.to(heroBg, {
        scale: 1,
        duration: 4,
        ease: "power2.out",
      });
    }

    // ── Entrance timeline ──
    const tl = gsap.timeline({ delay: 0.3 });

    // Eyebrow fade in
    if (eyebrow) {
      tl.to(eyebrow, { opacity: 1, duration: 0.8, ease: "expo.out" }, 0);
    }

    // Headline: kinetic lines (y: 100% → 0 per line, staggered)
    if (lineInners.length) {
      tl.to(lineInners, {
        y: 0,
        duration: 1,
        ease: "cubic-bezier(0.23, 1, 0.32, 1)",
        stagger: 0.12,
      }, 0.15);
    }

    // Subtitle: fade + y: 14 → 0
    if (subtitle) {
      tl.to(subtitle, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "expo.out",
      }, 0.6);
      gsap.set(subtitle, { y: 14 });
    }

    // CTA: fade + y: 14 → 0
    if (cta) {
      tl.to(cta, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "expo.out",
      }, 0.72);
      gsap.set(cta, { y: 14 });
    }

    // Logo: fade in with scale 0.95 → 1
    if (heroLogo) {
      tl.to(heroLogo, {
        opacity: 1,
        duration: 1.2,
        ease: "expo.out",
      }, 0.5);
    }
    if (logoImg) {
      tl.to(logoImg, {
        scale: 1,
        duration: 1.2,
        ease: "expo.out",
      }, 0.5);
    }

    // ── Scroll-driven parallax ──
    if (heroSection) {
      // Background moves slower (yPercent: 15)
      if (heroBg) {
        gsap.to(heroBg, {
          yPercent: 25,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        });
      }

      // Logo moves at a slightly different rate (yPercent: -10)
      if (heroLogo) {
        gsap.to(heroLogo, {
          yPercent: -20,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        });
      }
    }
  }
</script>
