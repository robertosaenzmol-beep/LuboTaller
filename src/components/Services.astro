---
import { Image } from 'astro:assets';
import serviceDiagnosis from '../assets/photos/service-diagnosis.jpg';
import serviceMaintenance from '../assets/photos/service-maintenance.jpg';
import serviceRepair from '../assets/photos/service-repair.jpg';
import serviceItv from '../assets/photos/gallery-close.jpg';

const featured = {
  title: 'Diagnosis',
  description: 'Conectamos tu coche al equipo de diagnosis y te explicamos el resultado con el coche delante, antes de decidir nada.',
  image: serviceDiagnosis,
  alt: 'Equipo de diagnosis conectado al coche, con la pantalla mostrando la lectura de las centralitas',
};

const services = [
  {
    title: 'Mantenimiento',
    description: 'Revisiones, aceite y filtros, frenos y distribución, según lo que marca el fabricante para tu coche.',
    image: serviceMaintenance,
    alt: 'Furgoneta azul subida al elevador del taller para una revisión',
  },
  {
    title: 'Reparación',
    description: 'Mecánica, electricidad y electrónica. Con presupuesto cerrado antes de empezar.',
    image: serviceRepair,
    alt: 'Mecánico trabajando en el motor de un coche con el capó abierto',
  },
  {
    title: 'Pre-ITV',
    description: 'Revisamos los puntos que mira la ITV para que vayas tranquilo. En la mayoría de casos, el coche está listo el mismo día.',
    image: serviceItv,
    alt: 'Furgoneta en el elevador bajo el techo de luces hexagonales del taller',
  },
];
---

<section id="servicios" class="section">
  <div class="container">
    <div class="head">
      <h2 class="t-h2">Qué hacemos</h2>
      <p class="t-body-lg measure sub">Coches y furgonetas de cualquier marca, del día a día.</p>
    </div>

    <div class="grid">
      <article class="feature">
        <Image src={featured.image} alt={featured.alt} widths={[480, 680]} sizes="(min-width: 900px) 640px, 100vw" />
        <div class="feature-body">
          <h3 class="t-h3">{featured.title}</h3>
          <p>{featured.description}</p>
        </div>
      </article>

      <ul class="list">
        {services.map((s) => (
          <li>
            <Image src={s.image} alt={s.alt} widths={[240, 400]} sizes="(min-width: 900px) 160px, 33vw" />
            <div>
              <h3 class="t-h3">{s.title}</h3>
              <p>{s.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: var(--s3); margin-bottom: var(--s6); }
  .head h2 { margin: 0; }
  .sub { margin: 0; color: var(--color-muted); }
  .grid { display: grid; gap: var(--s6); }
  .feature {
    background: var(--color-surface); border: 1px solid var(--color-line);
    border-radius: var(--radius); overflow: hidden; align-self: start;
  }
  .feature :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .feature-body { padding: var(--s4); }
  .feature-body p, .list p { margin: var(--s2) 0 0; }
  .t-h3 { margin: 0; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; }
  .list li {
    display: grid; grid-template-columns: 112px 1fr; gap: var(--s3);
    padding-block: var(--s4); border-top: 1px solid var(--color-line);
  }
  .list li:first-child { border-top: 0; padding-top: 0; }
  .list :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); display: block; }

  @media (min-width: 900px) {
    .head { grid-template-columns: 7fr 5fr; align-items: end; column-gap: var(--s6); }
    .grid { grid-template-columns: 7fr 5fr; column-gap: var(--s6); }
    .feature-body { padding: var(--s5); }
    .list li { grid-template-columns: 136px 1fr; gap: var(--s4); }
  }
</style>
