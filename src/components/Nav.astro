---
---

<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50"
  style="transition: background-color 600ms cubic-bezier(0.16, 1, 0.3, 1), border-color 600ms cubic-bezier(0.16, 1, 0.3, 1), backdrop-filter 600ms cubic-bezier(0.16, 1, 0.3, 1);"
>
  <nav
    class="mx-auto flex max-w-[1200px] items-center justify-between px-6 md:px-8 lg:px-12"
    style="height: 72px;"
    aria-label="Navegación principal del sitio"
  >
    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img
        src="/logo-lubo.png"
        alt="Logotipo de Lubo Taller"
        class="h-12 w-auto"
      />
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-10 md:flex" role="list">
      <li>
        <a
          href="#nosotros"
          class="font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#FAFAF9]/70 transition-colors duration-500 hover:text-[#C8A96E]"
          style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
        >
          Nosotros
        </a>
      </li>
      <li>
        <a
          href="#servicios"
          class="font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#FAFAF9]/70 transition-colors duration-500 hover:text-[#C8A96E]"
          style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
        >
          Servicios
        </a>
      </li>
      <li>
        <a
          href="#contacto"
          class="font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#FAFAF9]/70 transition-colors duration-500 hover:text-[#C8A96E]"
          style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
        >
          Contacto
        </a>
      </li>
    </ul>

    <!-- Desktop CTA -->
    <a
      href="tel:+34654463966"
      class="hidden items-center gap-2 font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.1em] text-[#FAFAF9]/70 transition-colors duration-500 hover:text-[#C8A96E] md:flex"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
      </svg>
      Tel. 654 463 966
    </a>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      type="button"
      class="relative flex h-11 w-11 items-center justify-center md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-lines">
        <span
          id="hamburger-line-1"
          class="block h-[1.5px] w-6 bg-[#FAFAF9]"
          style="transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);"
        ></span>
        <span
          id="hamburger-line-2"
          class="mt-[7px] block h-[1.5px] w-6 bg-[#FAFAF9]"
          style="transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);"
        ></span>
      </span>
    </button>
  </nav>

  <!-- Mobile full-screen overlay menu -->
  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 flex items-center justify-center bg-[#0C0A09] opacity-0 md:hidden"
    style="transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1);"
    aria-hidden="true"
  >
    <ul class="flex flex-col items-center justify-center gap-8" role="list">
      <li
        class="mobile-menu-item translate-y-6 opacity-0"
        style="transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 100ms;"
      >
        <a
          href="#nosotros"
          class="block font-['Cormorant',Georgia,serif] text-[36px] italic text-[#FAFAF9] transition-colors duration-500 hover:text-[#C8A96E]"
        >
          Nosotros
        </a>
      </li>
      <li
        class="mobile-menu-item translate-y-6 opacity-0"
        style="transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 200ms;"
      >
        <a
          href="#servicios"
          class="block font-['Cormorant',Georgia,serif] text-[36px] italic text-[#FAFAF9] transition-colors duration-500 hover:text-[#C8A96E]"
        >
          Servicios
        </a>
      </li>
      <li
        class="mobile-menu-item translate-y-6 opacity-0"
        style="transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 300ms;"
      >
        <a
          href="#contacto"
          class="block font-['Cormorant',Georgia,serif] text-[36px] italic text-[#FAFAF9] transition-colors duration-500 hover:text-[#C8A96E]"
        >
          Contacto
        </a>
      </li>
      <li
        class="mobile-menu-item translate-y-6 opacity-0 pt-4"
        style="transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 400ms;"
      >
        <a
          href="https://wa.me/34654463966"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-shimmer block bg-[#A16207] px-10 py-4 text-center font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#FAFAF9] transition-colors duration-500 hover:bg-[#C8A96E]"
        >
          Pide tu presupuesto
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  @media (min-width: 768px) {
    nav {
      height: 80px !important;
    }
  }
</style>

<script>
  const header = document.getElementById("main-nav") as HTMLElement | null;
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu") as HTMLDivElement | null;
  const line1 = document.getElementById("hamburger-line-1") as HTMLElement | null;
  const line2 = document.getElementById("hamburger-line-2") as HTMLElement | null;
  const menuItems = document.querySelectorAll(".mobile-menu-item");

  let isScrolled = false;

  function handleScroll(): void {
    if (!header) return;
    const scrollY = window.scrollY || document.documentElement.scrollTop;

    if (scrollY > 100 && !isScrolled) {
      isScrolled = true;
      header.classList.add("nav-scrolled");
    } else if (scrollY <= 100 && isScrolled) {
      isScrolled = false;
      header.classList.remove("nav-scrolled");
    }
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  function openMenu(): void {
    if (!menu || !toggle || !line1 || !line2) return;

    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Cerrar menú de navegación");
    menu.setAttribute("aria-hidden", "false");

    line1.style.transform = "translateY(4.25px) rotate(45deg)";
    line2.style.transform = "translateY(-4.25px) rotate(-45deg)";

    menu.classList.remove("pointer-events-none");
    menu.style.opacity = "1";

    document.body.style.overflow = "hidden";

    menuItems.forEach((item) => {
      const el = item as HTMLElement;
      el.style.opacity = "1";
      el.style.transform = "translateY(0)";
    });
  }

  function closeMenu(): void {
    if (!menu || !toggle || !line1 || !line2) return;

    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Abrir menú de navegación");
    menu.setAttribute("aria-hidden", "true");

    line1.style.transform = "translateY(0) rotate(0deg)";
    line2.style.transform = "translateY(0) rotate(0deg)";

    menu.style.opacity = "0";
    document.body.style.overflow = "";

    menuItems.forEach((item) => {
      const el = item as HTMLElement;
      el.style.opacity = "0";
      el.style.transform = "translateY(1.5rem)";
    });

    setTimeout(() => {
      menu.classList.add("pointer-events-none");
    }, 500);
  }

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    if (expanded) closeMenu();
    else openMenu();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle?.focus();
    }
  });
</script>

<style is:global>
  #main-nav {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  #main-nav.nav-scrolled {
    background-color: rgba(12, 10, 9, 0.95);
    border-bottom: 1px solid rgba(161, 98, 7, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>
