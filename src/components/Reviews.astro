---
/**
 * Reviews section - scroll device: flow + in
 * Editorial blockquotes with stagger reveal.
 * No cards. No identical layouts.
 */
const reviews = [
  {
    name: "Miguel",
    text: "Fui a realizar una pre-ITV y todo salió perfecto. Me atendieron genial, con mucha formalidad. Totalmente satisfecho, lo recomiendo sin duda.",
    source: "Google Reviews",
  },
  {
    name: "Ignacio López Moniche",
    text: "Buena atención y buen trabajo realizado. En un par de meses me tienen ahí de nuevo para hacerle el mantenimiento.",
    source: "Google Reviews",
  },
  {
    name: "Rolando Alejandro Calzada",
    text: "Trabajadores preparados y con conocimientos, te dicen la realidad del problema. Precios muy aceptables. Lo recomendaría sin dudas.",
    source: "Google Reviews",
  },
];
---

<section
  class="relative bg-[#14110E] py-[var(--sc-section)]"
  aria-labelledby="reviews-heading"
>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#A16207]/15 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto max-w-[1200px] px-6 md:px-8 lg:px-12">

    <!-- Heading -->
    <h2
      id="reviews-heading"
      data-review-animate
      class="max-w-[500px] font-[var(--font-display)] text-[clamp(2.2rem,5vw,4rem)] font-bold italic leading-[1.05] tracking-[var(--sc-track-tight)] text-[#F5EBDD]"
      style="font-family: var(--font-display);"
    >
      Lo que dicen de nosotros
    </h2>

    <!-- Featured review: asymmetric layout -->
    <article data-review-card class="relative mt-16 lg:mt-24">
      <div class="lg:ml-[12%] lg:max-w-[680px]">
        <span
          class="absolute -top-3 left-0 select-none text-[80px] leading-none text-[#A16207]/12 lg:-top-5 lg:text-[120px]"
          style="font-family: var(--font-display);"
          aria-hidden="true"
        >&ldquo;</span>
        <blockquote class="pl-4 lg:pl-0">
          <p
            class="text-[clamp(1.4rem,3vw,2.2rem)] italic leading-[1.35] text-[#F5EBDD]/85"
            style="font-family: var(--font-display); max-width: 40ch;"
          >
            {reviews[0].text}
          </p>
        </blockquote>
        <div class="mt-8 flex items-center gap-4">
          <div class="h-px w-10 bg-[#A16207]/40"></div>
          <p
            class="text-[11px] font-semibold uppercase tracking-[0.15em] text-[#F5EBDD]/50"
            style="font-family: var(--font-body);"
          >
            {reviews[0].name}
          </p>
          <span
            class="text-[10px] text-[#A2968A]/60"
            style="font-family: var(--font-body);"
          >
            {reviews[0].source}
          </span>
        </div>
      </div>
    </article>

    <!-- Divider -->
    <div class="gold-rule mx-auto mt-16 w-full max-w-[800px] lg:mt-20" aria-hidden="true"></div>

    <!-- Secondary reviews: two-column asymmetric -->
    <div class="mt-16 grid grid-cols-1 gap-14 lg:mt-20 lg:grid-cols-[1fr_1fr] lg:gap-24">
      {reviews.slice(1).map((review, i) => (
        <article data-review-card class="relative">
          <span
            class="absolute -top-2 left-0 select-none text-[48px] leading-none text-[#A16207]/8"
            style="font-family: var(--font-display);"
            aria-hidden="true"
          >&ldquo;</span>
          <div class:list={["pl-2 lg:pl-0", i === 1 && "lg:mt-12"]}>
            <blockquote>
              <p
                class="text-[clamp(1rem,2vw,1.35rem)] italic leading-[1.5] text-[#F5EBDD]/70"
                style="font-family: var(--font-display); max-width: 32ch;"
              >
                {review.text}
              </p>
            </blockquote>
            <div class="mt-6 flex items-center gap-3">
              <div class="h-px w-8 bg-[#A16207]/30"></div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#F5EBDD]/50"
                style="font-family: var(--font-body);"
              >
                {review.name}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const heading = document.querySelector("[data-review-animate]") as HTMLElement | null;
  const cards = document.querySelectorAll("[data-review-card]");

  if (!prefersReducedMotion) {
    // Heading entrance
    if (heading) {
      gsap.set(heading, { opacity: 0, y: 14 });
      gsap.to(heading, {
        opacity: 1,
        y: 0,
        duration: 0.62,
        ease: "cubic-bezier(0.23, 1, 0.32, 1)",
        scrollTrigger: {
          trigger: heading,
          start: "top 85%",
          once: true,
        },
      });
    }

    // Cards: stagger fade-in with rise (taste.md: 14px rise, 620ms, stagger 30-80ms)
    gsap.set(cards, { opacity: 0, y: 14 });
    cards.forEach((card, i) => {
      gsap.to(card, {
        opacity: 1,
        y: 0,
        duration: 0.62,
        ease: "cubic-bezier(0.23, 1, 0.32, 1)",
        scrollTrigger: {
          trigger: card,
          start: "top 88%",
          once: true,
        },
        delay: i * 0.06,
      });
    });
  } else {
    if (heading) heading.style.opacity = "1";
    cards.forEach((c) => {
      (c as HTMLElement).style.opacity = "1";
    });
  }
</script>
