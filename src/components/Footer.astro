<footer class="bg-[#0C0A09] pt-24 pb-12" role="contentinfo">
  <div class="mx-auto max-w-[1200px] px-6 md:px-8 lg:px-12">

    <!-- Large tagline -->
    <p class="mx-auto max-w-[700px] text-center font-['Cormorant',Georgia,serif] text-[clamp(1.5rem,3vw,2.2rem)] italic leading-[1.3] text-[#FAFAF9]/35">
      Cuidamos tu vehículo como si fuera nuestro
    </p>

    <!-- Gold rule -->
    <div class="gold-rule mx-auto mt-12 w-full max-w-[600px]" aria-hidden="true"></div>

    <!-- Columns -->
    <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-3">

      <!-- Column 1: Brand -->
      <div>
        <img src="/logo-lubo.png" alt="Lubo Taller" class="h-10 w-auto" />
        <p class="mt-5 max-w-[280px] font-['Montserrat',system-ui,sans-serif] text-[13px] font-light leading-[1.8] text-[#FAFAF9]/40">
          Taller mecánico de confianza en Alcobendas desde 1984. Tres generaciones al servicio de tu vehículo.
        </p>
      </div>

      <!-- Column 2: Contacto -->
      <div>
        <h3 class="font-['Montserrat',system-ui,sans-serif] text-[10px] font-semibold uppercase tracking-[0.2em] text-[#FAFAF9]/50">
          Contacto
        </h3>
        <ul class="mt-5 flex flex-col gap-3" role="list">
          <li class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40">
            C/ Capitán Francisco Sánchez 34, 28100 Alcobendas, Madrid
          </li>
          <li class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40">
            L-V: 9:00 - 19:00
          </li>
          <li>
            <a href="mailto:lubogaragesl@gmail.com" class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40 transition-colors duration-300 hover:text-[#C8A96E]">
              lubogaragesl@gmail.com
            </a>
          </li>
          <li>
            <a href="tel:+34654463966" class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40 transition-colors duration-300 hover:text-[#C8A96E]">
              654 463 966
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Legal + Social -->
      <div>
        <h3 class="font-['Montserrat',system-ui,sans-serif] text-[10px] font-semibold uppercase tracking-[0.2em] text-[#FAFAF9]/50">
          Legal
        </h3>
        <ul class="mt-5 flex flex-col gap-3" role="list">
          <li>
            <a href="/aviso-legal" class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40 transition-colors duration-300 hover:text-[#C8A96E]">
              Aviso Legal
            </a>
          </li>
          <li>
            <a href="/politica-de-privacidad" class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40 transition-colors duration-300 hover:text-[#C8A96E]">
              Política de Privacidad
            </a>
          </li>
          <li>
            <a href="/politica-de-cookies" class="font-['Montserrat',system-ui,sans-serif] text-[13px] font-light text-[#FAFAF9]/40 transition-colors duration-300 hover:text-[#C8A96E]">
              Política de Cookies
            </a>
          </li>
        </ul>

