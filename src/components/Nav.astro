---
---

<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50"
  style="transition: background-color 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), border-color 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), backdrop-filter 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1));"
>
  <nav
    class="mx-auto flex max-w-[1200px] items-center justify-between px-6 md:px-8 lg:px-12 h-16 md:h-[72px]"
    aria-label="Navegación principal del sitio"
  >
    <!-- Logo -->
    <a
      href="/"
      class="shrink-0 transition-transform duration-200 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#A16207] rounded"
    >
      <img
        src="/logo-lubo.png"
        alt="Logotipo de Lubo Taller"
        class="h-10 md:h-11 w-auto"
      />
    </a>

    <!-- Desktop CTA -->
    <a
      href="https://wa.me/34654463966"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 whitespace-nowrap bg-[#A16207] px-5 py-2.5 font-['DM_Sans',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.12em] text-[#F5EBDD] transition-all duration-300 hover:bg-[#C8A96E] hover:text-[#0A0806] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#A16207] rounded"
      style="transition-timing-function: var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1));"
    >
      Pide cita
    </a>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      type="button"
      class="relative flex h-11 w-11 items-center justify-center md:hidden active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#A16207] rounded"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-lines">
        <span
          id="hamburger-line-1"
          class="block h-[1.5px] w-6 bg-[#F5EBDD]"
          style="transition: transform 400ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), opacity 400ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1));"
        ></span>
        <span
          id="hamburger-line-2"
          class="mt-[7px] block h-[1.5px] w-6 bg-[#F5EBDD]"
          style="transition: transform 400ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), opacity 400ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1));"
        ></span>
      </span>
    </button>
  </nav>

  <!-- Mobile full-screen overlay menu -->
  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 flex items-center justify-center bg-[#0A0806] opacity-0 md:hidden"
    style="transition: opacity 500ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1));"
    aria-hidden="true"
  >
    <ul class="flex flex-col items-center justify-center gap-8" role="list">
      <li
        class="mobile-menu-item translate-y-6 opacity-0"
        style="transition: opacity 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), transform 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)); transition-delay: 100ms;"
      >
        <a
          href="#nosotros"
          class="block font-['Playfair_Display',Georgia,serif] text-[36px] italic text-[#F5EBDD] transition-colors duration-500 hover:text-[#C8A96E] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#A16207] rounded"
        >
          Nosotros
        </a>
      </li>
      <li
        class="mobile-menu-item translate-y-6 opacity-0"
        style="transition: opacity 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), transform 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)); transition-delay: 200ms;"
      >
        <a
          href="#servicios"
          class="block font-['Playfair_Display',Georgia,serif] text-[36px] italic text-[#F5EBDD] transition-colors duration-500 hover:text-[#C8A96E] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#A16207] rounded"
        >
          Servicios
        </a>
      </li>
      <li
        class="mobile-menu-item translate-y-6 opacity-0"
        style="transition: opacity 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), transform 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)); transition-delay: 300ms;"
      >
        <a
          href="#contacto"
          class="block font-['Playfair_Display',Georgia,serif] text-[36px] italic text-[#F5EBDD] transition-colors duration-500 hover:text-[#C8A96E] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#A16207] rounded"
        >
          Contacto
        </a>
      </li>
      <li
        class="mobile-menu-item translate-y-6 opacity-0 pt-4"
        style="transition: opacity 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)), transform 600ms var(--sc-ease-out, cubic-bezier(0.23, 1, 0.32, 1)); transition-delay: 400ms;"
      >
        <a
          href="https://wa.me/34654463966"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-shimmer block bg-[#A16207] px-10 py-4 text-center font-['DM_Sans',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#F5EBDD] transition-colors duration-500 hover:bg-[#C8A96E] hover:text-[#0A0806] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#A16207] rounded"
        >
          Pide cita
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("main-nav") as HTMLElement | null;
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu") as HTMLDivElement | null;
  const line1 = document.getElementById("hamburger-line-1") as HTMLElement | null;
  const line2 = document.getElementById("hamburger-line-2") as HTMLElement | null;
  const menuItems = document.querySelectorAll(".mobile-menu-item");

  let isScrolled = false;

  function handleScroll(): void {
    if (!header) return;
    const scrollY = window.scrollY || document.documentElement.scrollTop;

    if (scrollY > 100 && !isScrolled) {
      isScrolled = true;
      header.classList.add("nav-scrolled");
    } else if (scrollY <= 100 && isScrolled) {
      isScrolled = false;
      header.classList.remove("nav-scrolled");
    }
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  function openMenu(): void {
    if (!menu || !toggle || !line1 || !line2) return;

    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Cerrar menú de navegación");
    menu.setAttribute("aria-hidden", "false");

    line1.style.transform = "translateY(4.25px) rotate(45deg)";
    line2.style.transform = "translateY(-4.25px) rotate(-45deg)";

    menu.classList.remove("pointer-events-none");
    menu.style.opacity = "1";

    document.body.style.overflow = "hidden";

    menuItems.forEach((item) => {
      const el = item as HTMLElement;
      el.style.opacity = "1";
      el.style.transform = "translateY(0)";
    });
  }

  function closeMenu(): void {
    if (!menu || !toggle || !line1 || !line2) return;

    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Abrir menú de navegación");
    menu.setAttribute("aria-hidden", "true");

    line1.style.transform = "translateY(0) rotate(0deg)";
    line2.style.transform = "translateY(0) rotate(0deg)";

    menu.style.opacity = "0";
    document.body.style.overflow = "";

    menuItems.forEach((item) => {
      const el = item as HTMLElement;
      el.style.opacity = "0";
      el.style.transform = "translateY(1.5rem)";
    });

    setTimeout(() => {
      menu.classList.add("pointer-events-none");
    }, 500);
  }

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    if (expanded) closeMenu();
    else openMenu();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle?.focus();
    }
  });
</script>

<style is:global>
  #main-nav {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  #main-nav.nav-scrolled {
    background-color: rgba(10, 8, 6, 0.92);
    border-bottom: 1px solid rgba(161, 98, 7, 0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
</style>
