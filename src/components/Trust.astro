---
const stats = [
  { target: 40, suffix: "+", label: "Años de experiencia", format: "" },
  { target: 10000, suffix: "+", label: "Vehículos reparados", format: "es" },
  { target: 100, suffix: "%", label: "Presupuesto sin compromiso", format: "" },
];
---

<section
  id="nosotros"
  class="relative bg-[#14110E] py-32 lg:py-44"
  aria-labelledby="nosotros-heading"
  data-trust-section
>
  <div class="relative z-10 mx-auto max-w-[1200px] px-6 md:px-8 lg:px-12">

    <!-- Heading -->
    <div class="text-center">
      <h2
        id="nosotros-heading"
        data-trust-animate
        class="font-['Cormorant',Georgia,serif] text-[clamp(2.2rem,5vw,4rem)] font-bold italic leading-[1.05] text-[#F5EBDD]"
      >
        ¿Por qué Lubo Taller?
      </h2>
      <p
        data-trust-scrub
        class="mx-auto mt-6 max-w-[44ch] font-['Archivo',system-ui,sans-serif] text-[15px] font-light leading-[1.7]"
      >
        {
          "Más de cuatro décadas cuidando de los vehículos de Alcobendas. Tres generaciones de mecánicos con la misma pasión."
            .split(" ")
            .map((word) => (
              <span class="inline-block text-[#F5EBDD]/15" data-trust-word>{word}&nbsp;</span>
            ))
        }
      </p>
    </div>

    <!-- Gold rule -->
    <div class="mx-auto mt-16 h-px w-full max-w-[800px] bg-gradient-to-r from-transparent via-[#A16207]/40 to-transparent" aria-hidden="true"></div>

    <!-- Stats Row (clip-path wipe reveal) -->
    <div
      class="mx-auto mt-16 grid max-w-[1000px] grid-cols-1 lg:grid-cols-3"
      data-trust-stats-wrap
    >
      {stats.map((stat, i) => (
        <div
          class:list={[
            "flex flex-col items-center text-center py-10 lg:py-0",
            i < stats.length - 1 && "lg:border-r lg:border-[#A16207]/10",
          ]}
          data-stat
          style={`clip-path: inset(0 100% 0 0);`}
        >
          <span
            class="font-['Cormorant',Georgia,serif] font-light leading-none text-[#F5EBDD]"
            style="font-size: clamp(4.5rem, 12vw, 9rem);"
            data-count-target={stat.target}
            data-count-suffix={stat.suffix}
            data-count-format={stat.format || ""}
          >
            <span data-count-number>0</span><span class="text-[#A16207]">{stat.suffix}</span>
          </span>
          <span
            class="mt-4 font-['Archivo',system-ui,sans-serif] text-[10px] font-semibold uppercase tracking-[0.2em] text-[#A2968A]"
          >
            {stat.label}
          </span>
        </div>
      ))}
    </div>

    <!-- Bottom gold rule -->
    <div class="mx-auto mt-16 h-px w-full max-w-[800px] bg-gradient-to-r from-transparent via-[#A16207]/40 to-transparent" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector("[data-trust-section]") as HTMLElement;
  const animateEls = document.querySelectorAll("[data-trust-animate]");
  const statElements = document.querySelectorAll("[data-stat]");
  const counters = document.querySelectorAll("[data-count-target]");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  function formatNumber(value: number, useEsFormat: boolean): string {
    if (useEsFormat) return value.toLocaleString("es-ES");
    return String(value);
  }

  function setFinalValues() {
    counters.forEach((el) => {
      const target = parseInt(el.getAttribute("data-count-target") || "0", 10);
      const useEsFormat = el.getAttribute("data-count-format") === "es";
      const numberSpan = el.querySelector("[data-count-number]");
      if (numberSpan) numberSpan.textContent = formatNumber(target, useEsFormat);
    });
  }

  if (prefersReducedMotion) {
    // Skip all animations, show final state
    setFinalValues();
    gsap.set(animateEls, { opacity: 1, y: 0 });
    gsap.set(statElements, { clipPath: "inset(0 0% 0 0)" });
  } else {
    // Heading fade-in
    gsap.set(animateEls, { opacity: 0, y: 20 });
    ScrollTrigger.create({
      trigger: section,
      start: "top 80%",
      once: true,
      onEnter: () => {
        gsap.to(animateEls, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: "expo.out",
        });
      },
    });

    // Word-by-word opacity scrub on subtitle
    const scrubEl = document.querySelector("[data-trust-scrub]") as HTMLElement | null;
    const words = document.querySelectorAll("[data-trust-word]");
    if (scrubEl && words.length > 0) {
      gsap.to(words, {
        color: "rgba(245, 235, 221, 0.85)",
        stagger: 0.05,
        ease: "none",
        scrollTrigger: {
          trigger: scrubEl,
          start: "top 75%",
          end: "bottom 50%",
          scrub: true,
        },
      });
    }

    // Clip-path wipe reveal on stats
    statElements.forEach((el, index) => {
      ScrollTrigger.create({
        trigger: el,
        start: "top 85%",
        once: true,
        onEnter: () => {
          gsap.to(el, {
            clipPath: "inset(0 0% 0 0)",
            duration: 1,
            ease: "power3.out",
            delay: index * 0.2,
          });
        },
      });
    });

    // Counter roll-up (2s, ease-out)
    counters.forEach((el) => {
      const target = parseInt(el.getAttribute("data-count-target") || "0", 10);
      const useEsFormat = el.getAttribute("data-count-format") === "es";
      const numberSpan = el.querySelector("[data-count-number]");
      const obj = { value: 0 };

      ScrollTrigger.create({
        trigger: el,
        start: "top 85%",
        once: true,
        onEnter: () => {
          gsap.to(obj, {
            value: target,
            duration: 2,
            ease: "power2.out",
            onUpdate: () => {
              if (numberSpan) numberSpan.textContent = formatNumber(Math.round(obj.value), useEsFormat);
            },
          });
        },
      });
    });
  }
</script>
