---

<footer class="py-10 md:py-14" style="background: var(--color-navy);">
  <div class="mx-auto" style="max-width: 1160px; padding-inline: clamp(16px, 4vw, 32px);">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">

      <!-- Logo + legal -->
      <div>
        <div class="flex items-center gap-2 mb-2">
          <img src="/logo-lubo.png" alt="Lubo Taller" width="28" height="28" class="rounded-sm" />
          <span class="text-[1rem] font-600" style="font-family: var(--font-body); color: var(--color-surface);">Lubo Taller</span>
        </div>
        <p class="text-[0.8125rem]" style="color: var(--color-on-navy-muted);">
          Lubo Garage S.L. · CIF B23873540
        </p>
        <p class="mt-1 text-[0.8125rem]" style="color: var(--color-on-navy-muted);">
          C/ Capitán Francisco Sánchez 34, 28100 Alcobendas
        </p>
      </div>

      <!-- Contact -->
      <div>
        <a href="tel:+34654463966" class="block text-[1rem] font-600 mb-1" style="color: var(--color-surface);">654 463 966</a>
        <a href="mailto:lubogaragesl@gmail.com" class="block text-[0.875rem]" style="color: var(--color-on-navy-muted);">lubogaragesl@gmail.com</a>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-4">
        <a href="https://www.instagram.com/lubotaller/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition-opacity hover:opacity-80">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-on-navy-muted)" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/></svg>
        </a>
        <a href="https://www.facebook.com/people/Lubo-TallerGarage/61584842848921/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition-opacity hover:opacity-80">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-on-navy-muted)" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@lubo.taller" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="transition-opacity hover:opacity-80">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--color-on-navy-muted)" stroke="none"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.11v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V9.37a8.16 8.16 0 0 0 4.76 1.53v-3.4a4.85 4.85 0 0 1-1-.81z"/></svg>
        </a>
      </div>
    </div>

    <!-- Legal links -->
    <div class="mt-8 pt-6 border-t flex flex-wrap gap-5 text-[0.8125rem]" style="border-color: rgba(248,248,246,0.1); color: var(--color-on-navy-muted);">
      <a href="/aviso-legal" class="transition-colors hover:text-white/70">Aviso legal</a>
      <a href="/politica-de-privacidad" class="transition-colors hover:text-white/70">Política de privacidad</a>
      <a href="/politica-de-cookies" class="transition-colors hover:text-white/70">Cookies</a>
      <span class="ml-auto">&copy; Lubo Garage S.L.</span>
    </div>
  </div>
</footer>
