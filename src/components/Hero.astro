---
import { Image } from 'astro:assets';
import heroWorkshop from '../assets/photos/hero-workshop.jpg';
---

<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden pt-[80px]"
  aria-label="Presentacion de Lubo Taller"
>
  <!-- Real workshop photo background -->
  <div class="absolute inset-0 bg-[#0C0A09]" aria-hidden="true">
    <Image
      data-hero-bg
      src={heroWorkshop}
      alt=""
      class="absolute inset-0 h-full w-full scale-110 object-cover opacity-90"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0C0A09]/95 via-[#0C0A09]/55 to-[#0C0A09]/10"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#0C0A09] to-transparent"></div>
    <div class="absolute top-1/4 left-1/3 h-[600px] w-[600px] rounded-full bg-[#A16207]/[0.05] blur-[120px]"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6 md:px-8 lg:px-12">
    <!-- Overline -->
    <p
      data-hero-overline
      class="font-['Montserrat',system-ui,sans-serif] text-[10px] font-semibold uppercase tracking-[0.25em] text-[#A16207]"
    >
      Taller mecánico en Alcobendas &mdash; Desde 1984
    </p>

    <!-- H1 -->
    <h1
      data-hero-h1
      class="mt-6 max-w-[900px] text-[clamp(3rem,9vw,7.5rem)] font-bold italic leading-[0.95] tracking-[-0.03em] text-[#FAFAF9]"
      style="font-family: 'Cormorant', Georgia, serif; opacity: 1 !important; visibility: visible !important;"
    >
      Tu taller de<br />confianza
    </h1>

    <!-- Subtitle -->
    <p
      data-hero-subtitle
      class="mt-8 max-w-[480px] font-['Montserrat',system-ui,sans-serif] text-[clamp(0.875rem,1.5vw,1.1rem)] font-light leading-[1.7] tracking-[0.01em] text-[#FAFAF9]/65"
    >
      Reparación, mantenimiento y diagnosis de vehículos con más de 40 años de experiencia. Presupuesto sin compromiso.
    </p>

    <!-- CTAs -->
    <div data-hero-cta class="mt-12 flex flex-wrap items-center gap-4">
      <a
        href="https://wa.me/34654463966"
        target="_blank"
        rel="noopener noreferrer"
        class="cta-shimmer inline-block bg-[#A16207] px-10 py-4 font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#FAFAF9] transition-colors duration-500 hover:bg-[#C8A96E] active:scale-[0.98]"
      >
        Pide tu presupuesto
      </a>
      <a
        href="tel:+34654463966"
        class="inline-block border border-[#FAFAF9]/15 px-10 py-4 font-['Montserrat',system-ui,sans-serif] text-[11px] font-semibold uppercase tracking-[0.15em] text-[#FAFAF9]/70 transition-all duration-500 hover:border-[#C8A96E]/40 hover:text-[#C8A96E]"
      >
        654 463 966
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    data-hero-scroll
    class="absolute bottom-10 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3"
  >
    <span class="font-['Montserrat',system-ui,sans-serif] text-[9px] font-medium uppercase tracking-[0.2em] text-[#FAFAF9]/25">
      Descubre más
    </span>
    <svg
      data-hero-chevron
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="square"
      stroke-linejoin="miter"
      class="text-[#FAFAF9]/20"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const heroSection = document.querySelector('[aria-label="Presentacion de Lubo Taller"]') as HTMLElement | null;
  const overline = document.querySelector("[data-hero-overline]") as HTMLElement | null;
  const h1 = document.querySelector("[data-hero-h1]") as HTMLElement | null;
  const subtitle = document.querySelector("[data-hero-subtitle]") as HTMLElement | null;
  const cta = document.querySelector("[data-hero-cta]") as HTMLElement | null;
  const scrollEl = document.querySelector("[data-hero-scroll]") as HTMLElement | null;
  const chevron = document.querySelector("[data-hero-chevron]") as HTMLElement | null;
  const heroBg = document.querySelector("[data-hero-bg]") as HTMLElement | null;

  const allEls = [overline, h1, subtitle, cta, scrollEl].filter(Boolean);

  if (heroBg && !prefersReducedMotion) {
    gsap.to(heroBg, {
      scale: 1,
      duration: 6,
      ease: "power2.out",
    });
  } else if (heroBg) {
    heroBg.style.transform = "scale(1)";
  }

  if (prefersReducedMotion || allEls.length === 0) {
    allEls.forEach((el) => {
      if (el) {
        el.style.opacity = "1";
        el.style.transform = "none";
      }
    });
  } else {
    if (overline) gsap.set(overline, { opacity: 0, x: -20 });
    if (h1) gsap.set(h1, { y: 40 });
    if (subtitle) gsap.set(subtitle, { opacity: 0, y: 20 });
    if (cta) gsap.set(cta, { opacity: 0, y: 20 });
    if (scrollEl) gsap.set(scrollEl, { opacity: 0 });

    const tl = gsap.timeline({ delay: 0.3 });

    if (overline) {
      tl.to(overline, { opacity: 1, x: 0, duration: 0.8, ease: "expo.out" }, 0);
    }
    if (h1) {
      tl.to(h1, { y: 0, duration: 1.2, ease: "expo.out" }, 0.1);
    }
    if (subtitle) {
      tl.to(subtitle, { opacity: 1, y: 0, duration: 0.8, ease: "expo.out" }, 0.5);
    }
    if (cta) {
      tl.to(cta, { opacity: 1, y: 0, duration: 0.8, ease: "expo.out" }, 0.7);
    }
    if (scrollEl) {
      tl.to(scrollEl, { opacity: 1, duration: 0.6 }, 1.4);
    }

    if (chevron) {
      gsap.to(chevron, {
        y: 6,
        repeat: -1,
        yoyo: true,
        duration: 1.8,
        ease: "sine.inOut",
        delay: 2.0,
      });
    }

    // Scroll-driven parallax: background image moves slower than content
    if (heroBg && heroSection) {
      gsap.to(heroBg, {
        yPercent: 20,
        ease: "none",
        scrollTrigger: {
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });
    }

    // Content fades out and lifts as user scrolls past hero
    if (heroSection) {
      const contentEls = [overline, h1, subtitle, cta].filter(Boolean) as HTMLElement[];
      contentEls.forEach((el) => {
        gsap.to(el, {
          opacity: 0,
          y: -60,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "30% top",
            end: "80% top",
            scrub: true,
          },
        });
      });

      // Scroll indicator vanishes early
      if (scrollEl) {
        gsap.to(scrollEl, {
          opacity: 0,
          y: -20,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "8% top",
            end: "25% top",
            scrub: true,
          },
        });
      }
    }
  }
</script>
