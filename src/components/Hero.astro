---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photos/hero-workshop.jpg';
import LogoToken from './LogoToken.astro';
---

<section id="hero" class="hero">
  <div class="hero-photo">
    <Image
      src={heroPhoto}
      alt="El taller de Lubo por dentro: techo de luces hexagonales y un coche azul en la zona de trabajo"
      widths={[640, 1024]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="since">
      <LogoToken size={104} />
      <p><span class="since-label">Desde</span><span class="since-year">1984</span></p>
    </div>
  </div>

  <div id="hero-text" class="hero-panel">
    <div class="hero-inner">
      <h1 class="t-display">Te decimos lo que tiene tu coche. <span class="nowrap-line">Y lo que no.</span></h1>
      <p class="t-body-lg lead">
        Taller mecánico en Alcobendas. Diagnosis, mantenimiento y reparación. Presupuesto sin compromiso.
      </p>

      <div class="ctas">
        <a href="https://wa.me/34654463966" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Escríbenos por WhatsApp
        </a>
        <a href="tel:+34654463966" class="tel-link">o llama al <span>654 463 966</span></a>
      </div>

      <dl class="facts">
        <div>
          <dt class="sr-only">Valoración en Google</dt>
          <dd>
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span class="big">4,9</span>
            <span class="small">en Google · 60 opiniones</span>
          </dd>
        </div>
        <div>
          <dt class="sr-only">Horario</dt>
          <dd>
            <span class="big" data-open-status>L–V</span>
            <span class="small" data-open-detail>9:00–14:00 y 15:30–19:00</span>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero { display: grid; background: var(--color-navy); }
  .hero-photo { position: relative; min-height: 260px; aspect-ratio: 4 / 3; }
  .since {
    position: absolute; left: var(--gutter); bottom: var(--s4); z-index: 1;
    display: flex; align-items: center; gap: var(--s3);
    padding: var(--s2) var(--s4) var(--s2) var(--s2);
    background: var(--color-navy); border-radius: var(--radius);
  }
  .since p { margin: 0; display: grid; line-height: 1; }
  .since-label { font-size: .875rem; font-weight: 500; color: var(--color-on-navy-muted); }
  .since-year { font-family: var(--font-display); font-weight: 700; font-size: 2.75rem; letter-spacing: -0.01em; color: var(--color-surface); }
  @media (max-width: 639px) {
    .since { --token: 72px; bottom: var(--s3); gap: var(--s2); padding-right: var(--s3); }
    .since :global(.token) { width: 72px; height: 72px; }
    .since-year { font-size: 2rem; }
  }
  .hero-photo > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-panel {
    color: var(--color-surface);
    padding: var(--s6) var(--gutter);
    display: flex; align-items: center;
  }
  .hero-inner { max-width: 560px; }
  .hero-panel h1 { color: var(--color-surface); text-wrap: balance; margin: 0; }
  .nowrap-line { display: inline-block; }
  .lead { margin-top: var(--s4); color: var(--color-on-navy-muted); max-width: 40ch; }
  .ctas { margin-top: var(--s5); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s4); }
  .tel-link { color: var(--color-on-navy-muted); text-decoration: none; min-height: 48px; display: inline-flex; align-items: center; gap: .35em; }
  .tel-link span { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--color-surface); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .tel-link:hover span { text-decoration-thickness: 2px; }

  .facts {
    margin: var(--s6) 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4);
    border-top: 1px solid rgba(248, 248, 246, 0.16); padding-top: var(--s4);
  }
  .facts dd { margin: 0; display: grid; gap: 2px; }
  .stars { color: var(--color-brass); letter-spacing: 2px; font-size: .875rem; }
  .big { font-family: var(--font-display); font-weight: 700; font-size: 2.25rem; line-height: 1; color: var(--color-surface); }
  .small { font-size: .875rem; font-weight: 500; color: var(--color-on-navy-muted); }
  .facts div:last-child dd { align-content: end; }

  @media (min-width: 1024px) {
    .hero { grid-template-columns: 7fr 5fr; min-height: min(calc(100vh - var(--header-h)), 760px); }
    .hero-photo { aspect-ratio: auto; }
    .hero-panel { padding: var(--s7) var(--s6); }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-panel .hero-inner { animation: hero-in 300ms ease both; }
  }
  @keyframes hero-in { from { opacity: 0; } to { opacity: 1; } }
</style>

<script>
  // "Abierto ahora" from Madrid time. Server-rendered fallback shows the plain hours.
  const status = document.querySelector<HTMLElement>('[data-open-status]');
  const detail = document.querySelector<HTMLElement>('[data-open-detail]');
  if (status && detail) {
    const parts = new Intl.DateTimeFormat('es-ES', {
      timeZone: 'Europe/Madrid', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false,
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = get('weekday').replace('.', '');
    const mins = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
    const weekday = ['lun', 'mar', 'mié', 'jue', 'vie'].includes(day);
    const slots: [number, number, string][] = [[540, 840, '14:00'], [930, 1140, '19:00']];
    const open = weekday && slots.find(([a, b]) => mins >= a && mins < b);
    if (open) {
      status.textContent = 'Abierto';
      detail.textContent = `ahora, hasta las ${open[2]}`;
    } else if (weekday && mins >= 840 && mins < 930) {
      status.textContent = 'Cerrado';
      detail.textContent = 'por la comida, abrimos a las 15:30';
    } else if (weekday && mins < 540) {
      status.textContent = 'Cerrado';
      detail.textContent = 'abrimos hoy a las 9:00';
    } else {
      status.textContent = 'Cerrado';
      detail.textContent = day === 'vie' || day === 'sáb' ? 'abrimos el lunes a las 9:00' : 'abrimos mañana a las 9:00';
    }
  }
</script>
