---
/**
 * Signature move: A technical line-drawing of a car that builds itself
 * as the user scrolls through the page. stroke-dashoffset is driven
 * by page scroll progress via GSAP.
 *
 * Fixed position at bottom-right, subtle and persistent.
 * By the CTA section, the full car is drawn.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  data-car-line-draw
  class:list={[
    "pointer-events-none fixed bottom-6 right-6 z-40 lg:bottom-10 lg:right-10",
    className
  ]}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 320 120"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="h-auto w-[180px] lg:w-[280px]"
  >
    <!-- Car body outline -->
    <path
      data-car-path="body"
      d="M30 78 C30 78 38 76 50 75 L72 75 C82 75 90 62 98 52 C106 42 122 32 138 29 C154 26 178 25 202 25 C218 25 230 26 240 29 C252 33 264 40 274 52 C282 60 288 68 290 73 L298 74 C302 74 306 77 306 80 L306 82 L22 82 C22 80 26 78 30 78 Z"
      stroke="#A16207"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Roof line -->
    <path
      data-car-path="roof"
      d="M102 50 C110 38 126 30 148 27 C164 25 186 24 206 25 C222 26 236 28 244 32 C256 36 266 42 272 50"
      stroke="#C8A96E"
      stroke-width="0.75"
      stroke-linecap="round"
    />
    <!-- Window -->
    <path
      data-car-path="window"
      d="M110 50 C118 38 134 30 152 27 C168 25 186 24 204 25 C222 26 234 30 242 34 L264 50 Z"
      stroke="#A16207"
      stroke-width="0.5"
      stroke-linecap="round"
    />
    <!-- Window divider -->
    <line
      data-car-path="divider"
      x1="182" y1="25" x2="180" y2="50"
      stroke="#C8A96E"
      stroke-width="0.5"
    />
    <!-- Front wheel arch -->
    <path
      data-car-path="farch"
      d="M60 82 C60 66 70 58 84 58 C98 58 108 66 108 82"
      stroke="#A16207"
      stroke-width="1"
      stroke-linecap="round"
    />
    <!-- Front wheel -->
    <circle data-car-path="fwheel" cx="84" cy="82" r="14" stroke="#C8A96E" stroke-width="0.75" />
    <circle data-car-path="fhub" cx="84" cy="82" r="5" stroke="#A16207" stroke-width="0.5" />
    <!-- Rear wheel arch -->
    <path
      data-car-path="rarch"
      d="M226 82 C226 66 236 58 250 58 C264 58 274 66 274 82"
      stroke="#A16207"
      stroke-width="1"
      stroke-linecap="round"
    />
    <!-- Rear wheel -->
    <circle data-car-path="rwheel" cx="250" cy="82" r="14" stroke="#C8A96E" stroke-width="0.75" />
    <circle data-car-path="rhub" cx="250" cy="82" r="5" stroke="#A16207" stroke-width="0.5" />
    <!-- Headlight -->
    <ellipse data-car-path="head" cx="42" cy="72" rx="8" ry="3" stroke="#C8A96E" stroke-width="0.5" />
    <!-- Taillight -->
    <rect data-car-path="tail" x="292" y="68" width="8" height="5" rx="1" stroke="#C8A96E" stroke-width="0.5" />
    <!-- Ground line -->
    <line data-car-path="ground" x1="30" y1="96" x2="296" y2="96" stroke="#A16207" stroke-width="0.5" opacity="0.5" />
    <!-- Dimension line: wheelbase -->
    <g data-car-path="dim" opacity="0.4">
      <line x1="84" y1="100" x2="84" y2="108" stroke="#C8A96E" stroke-width="0.3" />
      <line x1="250" y1="100" x2="250" y2="108" stroke="#C8A96E" stroke-width="0.3" />
      <line x1="84" y1="106" x2="250" y2="106" stroke="#C8A96E" stroke-width="0.3" />
      <text x="167" y="114" text-anchor="middle" fill="#C8A96E" font-size="6" font-family="DM Sans, sans-serif" letter-spacing="0.1em">LUBO TALLER</text>
    </g>
  </svg>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const container = document.querySelector("[data-car-line-draw]") as HTMLElement | null;
  const paths = document.querySelectorAll("[data-car-path]");

  if (container && paths.length > 0 && !prefersReducedMotion) {
    // Calculate and set stroke-dasharray/offset for each path
    paths.forEach((el) => {
      if (el instanceof SVGGeometryElement) {
        const length = el.getTotalLength();
        (el as SVGElement).style.strokeDasharray = String(length);
        (el as SVGElement).style.strokeDashoffset = String(length);
      } else if (el instanceof SVGTextElement) {
        el.style.opacity = "0";
      }
    });

    // Container starts visible immediately
    gsap.set(container, { opacity: 0.9 });

    // Drive stroke-dashoffset from page scroll progress
    const geometryPaths = Array.from(paths).filter(
      (el) => el instanceof SVGGeometryElement
    ) as SVGGeometryElement[];

    const textEls = Array.from(paths).filter(
      (el) => el instanceof SVGTextElement
    );

    // Each path draws at a staggered point in the page scroll
    const totalPaths = geometryPaths.length;
    geometryPaths.forEach((path, i) => {
      const length = path.getTotalLength();
      const startProgress = i / (totalPaths + 2);
      const endProgress = (i + 2) / (totalPaths + 2);

      gsap.to(path, {
        strokeDashoffset: 0,
        ease: "none",
        scrollTrigger: {
          trigger: document.documentElement,
          start: `${startProgress * 100}% top`,
          end: `${Math.min(endProgress * 100, 90)}% top`,
          scrub: 1,
        },
      });
    });

    // Text labels appear at 80% scroll
    textEls.forEach((el) => {
      gsap.to(el, {
        opacity: 0.4,
        duration: 0.6,
        scrollTrigger: {
          trigger: document.documentElement,
          start: "75% top",
          once: true,
        },
      });
    });

    // Brighten at the CTA section (end of page)
    gsap.to(container, {
      opacity: 1,
      scrollTrigger: {
        trigger: document.documentElement,
        start: "85% top",
        end: "95% top",
        scrub: true,
      },
    });
  } else if (container && !prefersReducedMotion) {
    container.style.opacity = "0";
  } else if (container) {
    // Reduced motion: show completed drawing immediately at low opacity
    container.style.opacity = "0.3";
    paths.forEach((el) => {
      if (el instanceof SVGGeometryElement) {
        (el as SVGElement).style.strokeDashoffset = "0";
      }
    });
  }
</script>
