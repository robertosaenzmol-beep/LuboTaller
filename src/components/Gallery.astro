---
import { Image } from 'astro:assets';
import galleryClose from '../assets/photos/gallery-close.jpg';
import galleryConsultation from '../assets/photos/gallery-consultation.png';
import galleryOffice from '../assets/photos/gallery-office.jpg';

const items = [
  {
    image: galleryClose,
    alt: 'Mercedes V-Class elevado bajo el techo de luces hexagonal del taller',
    caption: 'El taller',
    description: 'Instalaciones equipadas para servicio integral de mecánica y electricidad.',
  },
  {
    image: galleryConsultation,
    alt: 'Mecánico explicando una reparación a un cliente junto al motor abierto',
    caption: 'Diagnóstico abierto',
    description: 'Revisión y presupuesto con el cliente presente. Sin sorpresas.',
  },
  {
    image: galleryOffice,
    alt: 'Escritorio de recepción del taller con documentación y herramientas',
    caption: 'Recepción y gestión',
    description: 'Coordinación de citas, recambios y seguimiento de cada intervención.',
  },
];
---

<section
  class="relative bg-[#0A0806]"
  aria-labelledby="galeria-heading"
  data-gallery-section
>
  <!-- Section header (scrolls normally, not pinned) -->
  <div class="mx-auto max-w-[1200px] px-6 pt-24 pb-10 md:px-8 lg:px-12 lg:pt-32 lg:pb-10">
    <h2
      id="galeria-heading"
      data-gallery-heading
      class="max-w-[600px] font-['Cormorant',Georgia,serif] text-[clamp(2.2rem,5vw,4rem)] font-bold italic leading-[1.05] text-[#F5EBDD]"
    >
      Así es nuestro día a día
    </h2>
  </div>

  <!-- Horizontal scroll track (pinned on desktop) -->
  <div data-gallery-track class="relative">
    <div
      data-gallery-slides
      class="flex flex-col gap-12 px-6 pb-16 lg:flex-row lg:flex-nowrap lg:gap-0 lg:px-0 lg:pb-0"
    >
      {items.map((item, i) => (
        <article
          data-gallery-panel
          class="relative w-full shrink-0 lg:flex lg:h-screen lg:w-[100vw] lg:items-center lg:justify-center"
        >
          <div class="mx-auto w-full max-w-[900px] lg:px-16">
            <div class="group relative overflow-hidden" style="aspect-ratio: 3/2;">
              <Image
                src={item.image}
                alt={item.alt}
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                widths={[480, 768, 1280, 1920]}
                sizes="(min-width: 1024px) 900px, 100vw"
                data-gallery-img
              />
              <!-- Subtle gradient at bottom for caption legibility -->
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0A0806]/80 via-transparent to-transparent" aria-hidden="true"></div>
            </div>

            <!-- Museum-label caption -->
            <div class="mt-5 lg:mt-6">
              <h3 class="font-['Cormorant',Georgia,serif] text-[clamp(1.3rem,2.5vw,1.8rem)] font-semibold italic text-[#F5EBDD]">
                {item.caption}
              </h3>
              <p class="mt-1.5 max-w-[40ch] font-['Archivo',system-ui,sans-serif] text-[13px] font-light leading-[1.65] text-[#A2968A]">
                {item.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Bottom spacer for mobile -->
  <div class="h-8 lg:h-0"></div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const headingEl = document.querySelector('[data-gallery-heading]') as HTMLElement | null;
  const isDesktop = window.matchMedia('(min-width: 1024px)').matches;

  if (prefersReducedMotion) {
    // Show everything immediately
    if (headingEl) gsap.set(headingEl, { opacity: 1, y: 0 });
    const panels = document.querySelectorAll('[data-gallery-panel]');
    gsap.set(panels, { opacity: 1, y: 0 });
  } else {
    // Heading entrance
    if (headingEl) {
      gsap.set(headingEl, { opacity: 0, y: 24 });
      gsap.to(headingEl, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'expo.out',
        scrollTrigger: {
          trigger: headingEl,
          start: 'top 85%',
          once: true,
        },
      });
    }

    if (isDesktop) {
      // --- Desktop: GSAP ScrollTrigger pin + horizontal pan ---
      const track = document.querySelector('[data-gallery-track]') as HTMLElement | null;
      const slidesContainer = document.querySelector('[data-gallery-slides]') as HTMLElement | null;
      const panels = document.querySelectorAll('[data-gallery-panel]');

      if (track && slidesContainer && panels.length > 0) {
        const totalScroll = slidesContainer.scrollWidth - window.innerWidth;

        // Panels are visible immediately — no blank flash
        gsap.set(panels, { opacity: 1, y: 0 });

        // Main horizontal scroll animation
        gsap.to(slidesContainer, {
          x: () => -totalScroll,
          ease: 'none',
          scrollTrigger: {
            trigger: track,
            start: 'top top',
            end: () => `+=${totalScroll * 1.2}`,
            pin: true,
            scrub: 1,
            invalidateOnRefresh: true,
          },
        });
      }
    } else {
      // --- Mobile (<1024px): vertical stack with stagger fade-in ---
      const panels = document.querySelectorAll('[data-gallery-panel]');
      gsap.set(panels, { opacity: 0, y: 36 });
      panels.forEach((panel, i) => {
        gsap.to(panel, {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'expo.out',
          scrollTrigger: {
            trigger: panel,
            start: 'top 88%',
            once: true,
          },
        });
      });
    }
  }
</script>
