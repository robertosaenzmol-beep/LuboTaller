---
/**
 * CTA section - scroll device: pin (resolving close)
 * The page arrives somewhere and stops. The close resolves and holds.
 * One action: WhatsApp. CTA as running text, not a button island.
 * Car line-drawing completes here (driven by CarLineDraw.astro).
 *
 * scroll-craft: "The last feeling is the one they carry, and a page
 * that trails off into a footer overwrites everything the peak did."
 */
---

<section
  id="contacto"
  class="relative flex min-h-[70vh] items-center justify-center bg-[#0A0806] py-[var(--sc-section)]"
  aria-labelledby="cta-heading"
>
  <!-- Radial warmth, subtle -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(161,98,7,0.04)_0%,transparent_60%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto max-w-[620px] px-6 text-center md:px-8">

    <h2
      id="cta-heading"
      data-cta-animate
      class="text-[clamp(2.2rem,6vw,4.5rem)] font-bold italic leading-[1.0] tracking-[var(--sc-track-tight)] text-[#F5EBDD]"
      style="font-family: var(--font-display);"
    >
      ¿Necesitas una revisión?
    </h2>

    <!-- Running text CTA, not a button island (chaptered editorial close) -->
    <p
      data-cta-animate
      class="mx-auto mt-8 max-w-[36ch] text-[15px] font-light leading-[1.7] text-[#A2968A]"
      style="font-family: var(--font-body);"
    >
      Llámanos o escríbenos por WhatsApp. Presupuesto sin compromiso.
      Lunes a viernes, 9:00 a 19:00.
    </p>

    <!-- Primary CTA: one label used everywhere -->
    <div data-cta-animate class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://wa.me/34654463966"
        target="_blank"
        rel="noopener noreferrer"
        data-cta-button
        class="cta-shimmer inline-block bg-[#A16207] px-10 py-4 text-[11px] font-semibold uppercase tracking-[0.15em] text-[#F5EBDD] transition-colors duration-300 hover:bg-[#C8A96E] active:scale-[0.97]"
        style="font-family: var(--font-body); transition-timing-function: var(--sc-ease-out);"
      >
        Pide cita
      </a>
      <a
        href="tel:+34654463966"
        class="inline-block border border-[#F5EBDD]/12 px-10 py-4 text-[11px] font-semibold uppercase tracking-[0.15em] text-[#F5EBDD]/60 transition-all duration-300 hover:border-[#C8A96E]/40 hover:text-[#C8A96E] active:scale-[0.97]"
        style="font-family: var(--font-body); transition-timing-function: var(--sc-ease-out);"
      >
        Llamar ahora
      </a>
    </div>

    <!-- Contact details: quiet, resolving -->
    <div data-cta-animate class="mt-14 flex flex-col items-center gap-3">
      <p class="text-[12px] text-[#A2968A]/60" style="font-family: var(--font-body);">
        C/ Capitán Francisco Sánchez 34, 28100 Alcobendas, Madrid
      </p>
      <a
        href="mailto:lubogaragesl@gmail.com"
        class="text-[12px] text-[#A2968A]/60 transition-colors duration-300 hover:text-[#C8A96E]"
        style="font-family: var(--font-body);"
      >
        lubogaragesl@gmail.com
      </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const elements = document.querySelectorAll("[data-cta-animate]");
  const ctaButton = document.querySelector("[data-cta-button]") as HTMLElement | null;

  if (!prefersReducedMotion && elements.length > 0) {
    // Flow + in: 14px rise, 620ms, stagger 60ms (taste.md spec)
    gsap.set(elements, { opacity: 0, y: 14 });
    gsap.to(elements, {
      opacity: 1,
      y: 0,
      duration: 0.62,
      stagger: 0.06,
      ease: "cubic-bezier(0.23, 1, 0.32, 1)",
      scrollTrigger: {
        trigger: "#contacto",
        start: "top 75%",
        once: true,
      },
    });

    // Subtle breathing glow on primary CTA (restrained)
    if (ctaButton) {
      gsap.to(ctaButton, {
        boxShadow: "0 0 32px rgba(161, 98, 7, 0.2), 0 0 64px rgba(161, 98, 7, 0.08)",
        repeat: -1,
        yoyo: true,
        duration: 3,
        ease: "sine.inOut",
        delay: 1.5,
      });
    }
  } else {
    elements.forEach((el) => {
      (el as HTMLElement).style.opacity = "1";
    });
  }
</script>
