---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 800 260"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Premium sedan silhouette in gold -->
  <g opacity="0.5">
    <!-- Body shell -->
    <path
      d="M80 190 C80 190 100 188 130 186 L180 186 C200 186 220 160 240 140 C260 120 300 100 340 95 C380 90 440 88 500 88 C540 88 570 90 590 95 C620 102 650 115 670 135 C685 150 695 165 700 178 L720 180 C730 180 740 185 740 190 L740 195 L60 195 C60 190 70 188 80 190 Z"
      fill="#A16207"
    />
    <!-- Roof line -->
    <path
      d="M250 138 C270 115 310 95 360 90 C400 86 460 85 510 86 C550 88 580 92 600 98 C625 106 645 118 660 132"
      stroke="#C8A96E"
      stroke-width="1.5"
      fill="none"
    />
    <!-- Window band -->
    <path
      d="M270 135 C285 115 320 100 370 95 C410 91 460 90 505 91 C545 93 575 98 595 105 L640 135 Z"
      fill="#0C0A09"
      opacity="0.6"
    />
    <!-- Window divider -->
    <line x1="450" y1="92" x2="445" y2="135" stroke="#A16207" stroke-width="1" />
    <!-- Front windshield edge -->
    <line x1="275" y1="135" x2="310" y2="98" stroke="#C8A96E" stroke-width="1" opacity="0.5" />
    <!-- Rear windshield edge -->
    <line x1="635" y1="135" x2="595" y2="103" stroke="#C8A96E" stroke-width="1" opacity="0.5" />
    <!-- Beltline chrome strip -->
    <line x1="130" y1="140" x2="700" y2="140" stroke="#C8A96E" stroke-width="1.5" opacity="0.4" />
    <!-- Front headlight -->
    <ellipse cx="120" cy="172" rx="20" ry="8" fill="#C8A96E" opacity="0.5" />
    <!-- Rear taillight -->
    <rect x="705" y="165" width="18" height="10" rx="2" fill="#C8A96E" opacity="0.4" />
    <!-- Front wheel arch -->
    <path
      d="M160 195 C160 165 180 150 210 150 C240 150 260 165 260 195"
      fill="#0C0A09"
    />
    <!-- Rear wheel arch -->
    <path
      d="M560 195 C560 165 580 150 610 150 C640 150 660 165 660 195"
      fill="#0C0A09"
    />
    <!-- Front wheel -->
    <circle cx="210" cy="195" r="35" fill="#1C1917" />
    <circle cx="210" cy="195" r="28" stroke="#A16207" stroke-width="1" fill="none" />
    <circle cx="210" cy="195" r="12" fill="#A16207" opacity="0.3" />
    <!-- Rear wheel -->
    <circle cx="610" cy="195" r="35" fill="#1C1917" />
    <circle cx="610" cy="195" r="28" stroke="#A16207" stroke-width="1" fill="none" />
    <circle cx="610" cy="195" r="12" fill="#A16207" opacity="0.3" />
    <!-- Ground reflection line -->
    <line x1="100" y1="230" x2="720" y2="230" stroke="#A16207" stroke-width="0.5" opacity="0.3" />
    <line x1="150" y1="235" x2="670" y2="235" stroke="#A16207" stroke-width="0.3" opacity="0.15" />
  </g>
</svg>
