---
/**
 * The "lámina": a workshop-manual drawing sheet that sits sticky
 * beside the story cards. Act 1 = car → diagnosis → worn pad.
 * Act 2 = parts list → what stays / what changes → keys back.
 * Purely illustrative: the cards carry the meaning, so it's aria-hidden.
 */
import Brake from './Brake.astro';
interface Props { act: 1 | 2 }
const { act } = Astro.props;

const sheets = act === 1
  ? [['1', 'El coche llega'], ['2', 'Diagnosis'], ['3', 'Freno delantero']]
  : [['4', 'Lista de piezas'], ['5', 'Qué se cambia'], ['6', 'Entrega']];
---
<svg class="lamina" viewBox="0 0 800 640" aria-hidden="true" focusable="false" data-act={act}>
  <defs>
    <pattern id={`grid-${act}`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" class="grid-line" />
    </pattern>
    <pattern id={`hatch-${act}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" class="hatch-line" />
    </pattern>
  </defs>

  <!-- Sheet -->
  <rect x="12" y="12" width="776" height="616" class="sheet" />
  <rect x="12" y="12" width="776" height="616" fill={`url(#grid-${act})`} />
  <rect x="12" y="12" width="776" height="616" class="frame" />

  <!-- Title block -->
  <g class="title-block">
    <rect x="560" y="580" width="216" height="36" class="frame" />
    <line x1="604" y1="580" x2="604" y2="616" class="frame" />
    {sheets.map(([n, name], i) => (
      <g class={`tb tb-${i}`}>
        <text x="582" y="606" class="tb-num" text-anchor="middle">{n}</text>
        <text x="616" y="604" class="svg-lbl-m">{name}</text>
      </g>
    ))}
    <text x="24" y="612" class="svg-lbl-m">Lubo Taller · Alcobendas</text>
  </g>

  {act === 1 && (
    <>
      <!-- Scene 0: the car arrives -->
      <g class="sc sc-car">
        <line class="ln-dash" x1="70" y1="490" x2="730" y2="490" />
        <path class="ln draw" pathLength="1"
          d="M 120 430 L 118 396 Q 120 372 150 365 L 270 345 L 350 278 Q 360 270 380 270 L 560 270 Q 600 272 620 300 L 660 360 Q 680 368 682 395 L 684 430 L 640 430 A 70 70 0 0 0 500 430 L 300 430 A 70 70 0 0 0 160 430 Z" />
        <path class="ln-thin draw" pathLength="1"
          d="M 290 345 L 355 287 Q 362 282 375 282 L 545 282 Q 580 284 598 305 L 625 345 Z" />
        <line class="ln-thin draw" x1="455" y1="282" x2="455" y2="425" pathLength="1" />
        <path class="ln-thin draw" pathLength="1" d="M 300 348 Q 296 390 306 428" />
        <line class="ln-thin draw" x1="470" y1="362" x2="494" y2="362" pathLength="1" />
        <line class="ln-thin draw" x1="335" y1="362" x2="359" y2="362" pathLength="1" />
        <path class="ln-thin draw" pathLength="1" d="M 125 381 L 166 372 L 169 385 L 128 391 Z" />
        <path class="ln-thin draw" pathLength="1" d="M 667 372 L 680 380 L 681 397 L 670 397 Z" />
        <path class="ln-thin draw" pathLength="1" d="M 298 343 L 314 331 L 322 343" />
        <!-- wheels -->
        <circle class="ln draw" cx="230" cy="432" r="58" pathLength="1" />
        <circle class="ln-thin draw" cx="230" cy="432" r="38" pathLength="1" />
        <circle class="ln-thin draw" cx="230" cy="432" r="9" pathLength="1" />
        <circle class="ln draw" cx="570" cy="432" r="58" pathLength="1" />
        <circle class="ln-thin draw" cx="570" cy="432" r="38" pathLength="1" />
        <circle class="ln-thin draw" cx="570" cy="432" r="9" pathLength="1" />
        <!-- detail A callout -->
        <g class="callout">
          <circle class="ln-dash" cx="230" cy="432" r="86" />
          <line class="ln-thin" x1="169" y1="493" x2="124" y2="540" />
          <circle class="ln fill-s" cx="112" cy="552" r="16" />
          <text x="112" y="558" class="svg-lbl" text-anchor="middle">A</text>
          <text x="138" y="558" class="svg-lbl">Freno delantero</text>
        </g>
      </g>

      <!-- Scene 1: diagnosis -->
      <g class="sc sc-diag">
        <text x="150" y="250" class="svg-lbl-m">Toma de diagnosis (OBD)</text>
        <path class="ln draw fill-s" pathLength="1" d="M 150 270 L 350 270 L 330 370 L 170 370 Z" />
        <path class="ln-thin draw" pathLength="1" d="M 164 282 L 336 282 L 320 358 L 180 358 Z" />
        <g class="pins">
          {Array.from({ length: 8 }, (_, i) => <circle class="ln-thin" cx={185 + i * 18.6} cy="302" r="5" />)}
          {Array.from({ length: 8 }, (_, i) => <circle class="ln-thin" cx={190 + i * 17.1} cy="338" r="5" />)}
        </g>
        <path class="ln draw" pathLength="1" d="M 250 370 C 250 480 440 480 470 360" />
        <rect class="ln draw fill-s" x="470" y="200" width="250" height="180" rx="14" pathLength="1" />
        <rect class="ln-thin draw" x="485" y="215" width="220" height="150" rx="4" pathLength="1" />
        <line class="ln-thin draw" x1="497" y1="232" x2="577" y2="232" pathLength="1" />
        <line class="ln-thin draw" x1="497" y1="246" x2="547" y2="246" pathLength="1" />
        <path class="ln draw" pathLength="1"
          d="M 495 310 L 515 310 L 522 272 L 530 338 L 538 310 L 560 310 L 567 266 L 575 344 L 583 310 L 605 310 L 612 286 L 620 330 L 628 310 L 695 310" />
        <text x="470" y="410" class="svg-lbl-m">Equipo de diagnosis</text>
      </g>

      <!-- Scene 2: brake + worn pad -->
      <g class="sc sc-brake">
        <g transform="translate(290 330)"><Brake /></g>
        <g class="labels-explode">
          <text x="140" y="140" class="svg-lbl">Disco</text>
          <line class="ln-thin" x1="170" y1="146" x2="196" y2="196" />
          <text x="590" y="182" class="svg-lbl">Pastilla</text>
        </g>
        <g class="xsection">
          <text x="500" y="428" class="svg-lbl-m">Sección de la pastilla</text>
          <rect class="ln-dash" x="510" y="454" width="160" height="72" />
          <rect class="ln fill-s" x="500" y="440" width="180" height="14" />
          <rect class="ln" fill={`url(#hatch-${act})`} x="510" y="454" width="160" height="18" />
          <line class="ln-thin" x1="682" y1="454" x2="682" y2="472" />
          <line class="ln-thin" x1="676" y1="454" x2="688" y2="454" />
          <line class="ln-thin" x1="676" y1="472" x2="688" y2="472" />
          <text x="694" y="478" class="svg-big">3 mm</text>
          <text x="510" y="548" class="svg-lbl-m">Nueva: unos 12 mm</text>
        </g>
      </g>
    </>
  )}

  {act === 2 && (
    <>
      <g class="sc sc-brake2">
        <g class="brake-scale">
          <g transform="translate(290 330)"><Brake withNewPad /></g>
        </g>
        <g class="balloons">
          <line class="ln-thin" x1="660" y1="262" x2="700" y2="236" />
          <circle class="ln fill-s" cx="712" cy="228" r="15" />
          <text x="712" y="234" class="svg-lbl" text-anchor="middle">1</text>
          <line class="ln-thin" x1="177" y1="217" x2="140" y2="176" />
          <circle class="ln fill-s" cx="130" cy="164" r="15" />
          <text x="130" y="170" class="svg-lbl" text-anchor="middle">2</text>
        </g>
        <g class="measure">
          <line class="ln-thin" x1="196" y1="424" x2="130" y2="520" />
          <text x="60" y="542" class="svg-lbl">Grosor 22,4 mm</text>
          <text x="60" y="562" class="svg-lbl-m">Mínimo del fabricante: 21 mm</text>
          <path class="ln-strong" d="M 30 532 l 7 8 l 14 -16" />
          <text x="590" y="186" class="svg-lbl">Nuevas</text>
        </g>
      </g>

      <!-- Parts table -->
      <g class="sc sc-table">
        <line class="ln-thin" x1="460" y1="420" x2="776" y2="420" />
        <text x="466" y="412" class="svg-lbl-m">Nº</text>
        <text x="496" y="412" class="svg-lbl-m">Pieza</text>
        <text x="640" y="412" class="svg-lbl-m">Qué hacemos</text>
        <line class="ln-thin" x1="460" y1="460" x2="776" y2="460" />
        <line class="ln-thin" x1="460" y1="500" x2="776" y2="500" />
        <line class="ln-thin" x1="460" y1="540" x2="776" y2="540" />
        <text x="468" y="446" class="svg-lbl">1</text>
        <text x="496" y="446" class="svg-lbl">Pastillas</text>
        <text x="468" y="486" class="svg-lbl">2</text>
        <text x="496" y="486" class="svg-lbl">Discos</text>
        <text x="468" y="526" class="svg-lbl">3</text>
        <text x="496" y="526" class="svg-lbl">Líquido</text>
        <text x="640" y="446" class="svg-lbl">Cambiar</text>
        <g class="st-before"><text x="640" y="486" class="svg-lbl">Medir</text></g>
        <g class="st-after"><text x="640" y="486" class="svg-lbl st-strong">Se queda</text></g>
        <text x="640" y="526" class="svg-lbl">Revisar</text>
      </g>

      <!-- Keys back -->
      <g class="sc sc-key">
        <circle class="ln draw" cx="605" cy="186" r="26" pathLength="1" />
        <rect class="ln draw fill-s" x="560" y="214" width="90" height="156" rx="40" pathLength="1" />
        <circle class="ln-thin draw" cx="605" cy="262" r="12" pathLength="1" />
        <circle class="ln-thin draw" cx="605" cy="300" r="12" pathLength="1" />
        <rect class="ln-thin draw" x="590" y="330" width="30" height="14" rx="7" pathLength="1" />
        <path class="ln draw" pathLength="1" d="M 595 370 L 595 470 L 605 484 L 615 470 L 615 370" />
        <line class="ln-thin draw" x1="605" y1="382" x2="605" y2="462" pathLength="1" />
        <path class="ln-thin draw" pathLength="1" d="M 628 176 C 660 168 700 186 718 210" />
        <rect class="ln draw fill-s" x="670" y="200" width="100" height="96" rx="6" pathLength="1" />
        <circle class="ln-thin draw" cx="720" cy="216" r="5" pathLength="1" />
        <g class="key-tag">
          <text x="720" y="258" class="svg-big-sm" text-anchor="middle">Listo</text>
          <text x="720" y="280" class="svg-lbl-m" text-anchor="middle">mismo día</text>
        </g>
      </g>
    </>
  )}
</svg>
