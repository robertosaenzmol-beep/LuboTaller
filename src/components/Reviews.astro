---
// Texts must match Google word for word. Re-check before launch.
const featured = {
  name: 'Miguel',
  text: 'Fui a realizar una pre-ITV y todo salió perfecto. Muy atentos y profesionales. El taller está muy limpio y organizado.',
};
const reviews = [
  {
    name: 'Rolando Alejandro Calzada',
    text: 'Trabajadores preparados y con conocimientos. Me explicaron todo lo que iban a hacer antes de tocar el coche. Transparencia total.',
  },
  {
    name: 'Ignacio López Moniche',
    text: 'Buena atención y buen trabajo realizado. Muy recomendable. Volveré sin duda para el mantenimiento de mi coche.',
  },
];
---

<section id="opiniones" class="section reviews">
  <div class="container">
    <div class="head">
      <h2 class="t-h2">Lo que dicen en Google</h2>
      <p class="score">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span class="num">4,9</span>
        <span class="count">de 5 · 60 opiniones</span>
      </p>
    </div>

    <div class="grid">
      <figure class="featured">
        <blockquote><p>&ldquo;{featured.text}&rdquo;</p></blockquote>
        <figcaption class="t-small">{featured.name} · Google</figcaption>
      </figure>

      <div class="others">
        {reviews.map((r) => (
          <figure>
            <span class="stars sm" aria-label="5 estrellas">★★★★★</span>
            <blockquote><p class="t-body-lg">&ldquo;{r.text}&rdquo;</p></blockquote>
            <figcaption class="t-small">{r.name} · Google</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <a href="https://www.google.com/maps/search/?api=1&query=Lubo+Taller+Alcobendas" target="_blank" rel="noopener noreferrer" class="btn btn-on-dark more">
      Ver todas las opiniones en Google
    </a>
  </div>
</section>

<style>
  .reviews { background: var(--color-navy); color: var(--color-surface); }
  .reviews .t-h2 { color: var(--color-surface); margin: 0; }
  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s3); margin-bottom: var(--s6); }
  .score { margin: 0; display: flex; align-items: baseline; gap: var(--s2); }
  .stars { color: var(--color-brass); letter-spacing: 2px; }
  .stars.sm { font-size: .875rem; }
  .num { font-family: var(--font-display); font-weight: 700; font-size: 2.5rem; line-height: 1; }
  .count { font-size: .875rem; font-weight: 500; color: var(--color-on-navy-muted); }

  .grid { display: grid; gap: var(--s6); }
  figure { margin: 0; }
  blockquote { margin: 0; }
  .featured p {
    margin: 0; font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem); line-height: 1.12; max-width: 24ch; text-wrap: pretty;
  }
  figcaption { margin-top: var(--s3); color: var(--color-on-navy-muted); }
  .others { display: grid; gap: var(--s5); }
  .others figure { border-top: 1px solid rgba(248, 248, 246, 0.16); padding-top: var(--s4); }
  .others p { margin: var(--s2) 0 0; color: var(--color-surface); }
  .more { margin-top: var(--s6); }

  @media (min-width: 900px) {
    .grid { grid-template-columns: 7fr 5fr; column-gap: var(--s7); }
  }
</style>
