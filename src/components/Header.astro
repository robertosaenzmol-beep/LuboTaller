---
const wa = `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Lubo Taller, inicio">
      <img src="/logo-lubo.png" alt="" width="36" height="36" />
      <span>Lubo Taller</span>
    </a>

    <nav class="nav" aria-label="Secciones">
      <a href="/#servicios">Servicios</a>
      <a href="/#nosotros">Cómo trabajamos</a>
      <a href="/#opiniones">Opiniones</a>
      <a href="/#contacto">Contacto</a>
    </nav>

    <div class="actions">
      <a href="tel:+34654463966" class="phone" aria-label="Llamar al 654 463 966">
        <svg class="phone-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="phone-num">654 463 966</span>
      </a>
      <a href="https://wa.me/34654463966" target="_blank" rel="noopener noreferrer" class="btn btn-primary wa" aria-label="Escríbenos por WhatsApp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={wa} />
        <span class="wa-label">WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s3); height: 60px; }
  .brand { display: flex; align-items: center; gap: var(--s2); text-decoration: none; }
  .brand img { border-radius: 4px; }
  .brand span { font-weight: 600; color: var(--color-navy); display: none; }
  .nav { display: none; gap: var(--s4); font-size: .9375rem; font-weight: 500; }
  .nav a { color: var(--color-muted); text-decoration: none; padding-block: var(--s2); }
  .nav a:hover { color: var(--color-navy); }
  .actions { display: flex; align-items: center; gap: var(--s2); }
  .phone {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--s2);
    min-width: 48px; min-height: 48px; color: var(--color-rust); text-decoration: none;
    border: 2px solid var(--color-line); border-radius: var(--radius);
  }
  .phone-num { display: none; font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; letter-spacing: .01em; }
  .phone:hover { color: var(--color-rust-dark); }
  .wa { padding-inline: 14px; }
  .wa-label { display: none; }

  @media (min-width: 640px) {
    .brand span { display: inline; }
    .phone { border: 0; padding-inline: var(--s2); }
    .phone-icon { display: none; }
    .phone-num { display: inline; }
    .wa { padding-inline: 20px; }
    .wa-label { display: inline; }
  }
  @media (min-width: 960px) {
    .nav { display: flex; }
  }
</style>
