---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lubo Taller — Tu taller de confianza desde 1984 | Alcobendas, Madrid",
  description = "Taller mecánico en Alcobendas, Madrid. Más de 40 años de experiencia en diagnosis, mantenimiento y reparación de vehículos. Presupuesto sin compromiso."
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "Lubo Taller",
  "alternateName": "Lubo Garage S.L.",
  "description": description,
  "url": "https://lubotaller.es",
  "telephone": "+34654463966",
  "email": "lubogaragesl@gmail.com",
  "foundingDate": "1984",
  "image": "/logo-lubo.png",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Capitán Francisco Sánchez 34",
    "addressLocality": "Alcobendas",
    "addressRegion": "Madrid",
    "postalCode": "28100",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "40.5468",
    "longitude": "-3.6419"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "19:00"
  },
  "sameAs": [
    "https://www.facebook.com/people/Lubo-TallerGarage/61584842848921/",
    "https://www.instagram.com/lubotaller/",
    "https://www.tiktok.com/@lubo.taller"
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-lubo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://lubotaller.es" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo-lubo.png" />
    <meta property="og:url" content="https://lubotaller.es" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo-lubo.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700&family=Cormorant:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <slot />
  </body>
</html>
